<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Overlay View for Bounding Boxes & HUD -->
    <com.kylescholz.otterspotter.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#99080C14"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_otter_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Otter Spotter Logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Otter Spotter"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Indicator Pill / Auto Photo Toggle Control -->
        <TextView
            android:id="@+id/tv_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Auto Photo"
            android:textColor="@color/color_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#33FF9100"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <!-- Torch Button (Material 3) -->
        <ImageButton
            android:id="@+id/btn_torch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_flashlight"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:tint="@color/text_white"
            android:contentDescription="Torch" />

        <!-- Hamburger Menu Button (Material 3) -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu"
            android:scaleType="fitCenter"
            android:padding="6dp"
            app:tint="@color/text_white"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- Telemetry HUD -->
    <LinearLayout
        android:id="@+id/hud_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bg_surface_80"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- Line 1: FPS and Latency (always gray) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_hud_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS: 0"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hud_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latency: --"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 2: Otters & Throat pattern counts (only when > 0) -->
        <LinearLayout
            android:id="@+id/layout_hud_detections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_hud_otters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otters: 0"
                android:textColor="@color/color_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_hud_divider_detections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_hud_throats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Throat patterns: 0"
                android:textColor="@color/color_emerald"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>


    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="#CC080C14"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Zoom Presets -->
        <LinearLayout
            android:id="@+id/layout_zoom_presets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zoom_1x"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:minWidth="48dp"
                android:layout_height="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1x"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zoom_2x"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:minWidth="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="2x"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zoom_5x"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:minWidth="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="5x"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zoom_10x"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:minWidth="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="10x"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zoom_max"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:minWidth="56dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="MAX"
                android:textColor="@color/color_cyan"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/color_cyan" />
        </LinearLayout>

        <!-- Shutter & Controls Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Gallery Button (Left of Shutter) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btn_shutter_instant"
                android:layout_marginEnd="40dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/text_white"
                app:iconSize="24dp"
                app:strokeColor="@color/text_muted"
                app:strokeWidth="1.5dp"
                app:backgroundTint="@color/bg_surface_80"
                android:contentDescription="Gallery" />

            <!-- Center Shutter Button (Clean circle, no icon) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_shutter_instant"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_centerInParent="true"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="34dp"
                app:backgroundTint="@color/text_white"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="4dp"
                android:contentDescription="Shutter" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Photo Saved Notification Toast / Banner -->
    <LinearLayout
        android:id="@+id/layout_saved_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/bg_surface_80"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_saved_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📸 Saved to DCIM/Otter Spotter"
            android:textColor="@color/color_emerald"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full-screen Shutter Flash Effect -->
    <View
        android:id="@+id/v_shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0.0"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
