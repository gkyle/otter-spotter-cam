<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OtterCam" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_cyan</item>
        <item name="colorPrimaryVariant">@color/color_emerald</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.OtterCam.Fullscreen" parent="Theme.OtterCam">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="ShapeAppearance.OtterCam.RoundedThumb" parent="">
        <item name="cornerSize">8dp</item>
    </style>
</resources>
